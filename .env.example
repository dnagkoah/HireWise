# ─────────────────────────────────────────────────────────────
# HireWise — mẫu biến môi trường.
# Chép sang `.env` rồi điền giá trị thật:  cp .env.example .env
# `.env` KHÔNG được commit (xem .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# Ba biến đầu do image postgres đọc lúc initdb. DATABASE_URL là thứ backend dùng,
# và host phải là `db` — tên service trong docker-compose, không phải localhost.
POSTGRES_USER=hirewise
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=hirewise
DATABASE_URL=postgresql://hirewise:doi-mat-khau-nay@db:5432/hirewise

# ── Bảo mật ──────────────────────────────────────────────────
# Khoá ký JWT. Sinh khoá mới:  openssl rand -hex 32
SECRET_KEY=thay-bang-chuoi-ngau-nhien-du-dai

# Tài khoản admin được tạo tự động lúc khởi động (app/core/bootstrap.py).
# Đăng nhập lần đầu bằng cặp này rồi đổi mật khẩu ngay.
DEFAULT_ADMIN_EMAIL=admin@hirewise.com
DEFAULT_ADMIN_PASSWORD=doi-mat-khau-nay

# Token chặn cổng MCP nội bộ. Thiếu biến này, MCP server TỪ CHỐI khởi động —
# cố ý, để không bao giờ tồn tại một endpoint đọc/ghi ẩn danh vào DB tuyển dụng.
MCP_AUTH_TOKEN=sinh-mot-chuoi-ngau-nhien-khac

# ── Gửi mail (mã xác minh, thư mời phỏng vấn, thư báo kết quả) ─
# Gmail: bật 2FA rồi tạo App Password 16 ký tự, KHÔNG dùng mật khẩu đăng nhập.
# Bỏ trống cũng chạy được — mọi tính năng mail sẽ báo "chưa cấu hình" thay vì lỗi.
MAIL_USERNAME=ban@gmail.com
MAIL_PASSWORD=app-password-16-ky-tu
MAIL_FROM=ban@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# ── Groq (LLM) ───────────────────────────────────────────────
# Lấy key ở https://console.groq.com/keys.
#
# Pipeline chấm CV dùng KEY_1 + KEY_2 (hai tài khoản riêng -> ngân sách token gấp
# đôi trên free tier). GROQ_MCP_API_KEY tách riêng cho khung chat Copilot, để một
# lượt upload nặng không ăn hết hạn mức của phần chat. Có thể điền cùng một key
# vào cả ba nếu chỉ có một tài khoản.
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_MCP_API_KEY=gsk_...

# Model chính / dự phòng / model nhẹ cho việc phụ. Groq đổi danh mục model khá
# thường xuyên — kiểm tra lại tại https://console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_BACKUP=openai/gpt-oss-20b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Danh sách model rơi dần cho khung chat khi model chính bị 429 hoặc bị gỡ.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
